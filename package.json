{
  "name": "e-travel",
  "private": true,
  "version": "1.0.0",
  "description": "e起去旅行 — 旅游景区介绍与旅游攻略网站",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node server/index.js",
    "build": "vite build --config frontend/vite.config.js",
    "build:pages": "node scripts/build-static.mjs && vite build --config frontend/vite.config.js",
    "start": "node server/index.js",
    "preview": "vite preview --config frontend/vite.config.js",
    "smoke": "node scripts/smoke-api.mjs"
  },
  "dependencies": {
    "express": "4.22.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "vite": "5.4.21"
  }
}
